{
  "name": "qiscreenwrite",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first screenplay writing and world building, with optional connections to CanIScreenwrite.com and QiMovi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cr8ph8/QiScreenwrite.git"
  },
  "homepage": "https://github.com/cr8ph8/QiScreenwrite#readme",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite --config vite.local.config.ts --open /local.html",
    "build": "vite build --config vite.local.config.ts",
    "check": "tsc --noEmit -p tsconfig.local.json",
    "test": "vitest run",
    "test:local": "node --test local/tests/*.test.mjs",
    "test:catalog": "node iphone/scripts/export-film-language.mjs --check",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "start": "node local/server/cli.mjs serve --port 4318 --dist dist-local --open",
    "local:init": "node local/server/cli.mjs init",
    "local:serve": "node local/server/cli.mjs serve --port 4318 --dist dist-local",
    "local:app": "node local/server/cli.mjs serve --port 4318 --dist dist-local --open",
    "local:status": "node local/server/cli.mjs status",
    "dev:local": "vite --config vite.local.config.ts --open /local.html",
    "build:local": "vite build --config vite.local.config.ts",
    "check:local": "tsc --noEmit -p tsconfig.local.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/supabase-js": "^2.100.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "fast-check": "^4.9.0",
    "jsdom": "^20.0.3",
    "jszip": "^3.10.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "postcss-selector-parser": "6.1.5",
    "source-map-js": "1.2.2"
  }
}
